server {
    listen ${PORT};
    server_name _;

    root /var/www/frontend;
    index index.html;
    client_max_body_size 20M;
    server_tokens off;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    location ~ ^/(api|up)(/|$) {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/backend/public/index.php;
        fastcgi_param DOCUMENT_ROOT   /var/www/backend/public;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_read_timeout 120;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}

# Project website (site/ folder), served on its own domain from this same container.
server {
    listen ${PORT};
    server_name bos.sifat.codes;

    root /var/www/site;
    index index.html;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
